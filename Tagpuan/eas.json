{
  "cli": {
    "version": ">= 16.15.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-ceeredtwqa-as.a.run.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-ceeredtwqa-as.a.run.app"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "image": "latest"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-ceeredtwqa-as.a.run.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}